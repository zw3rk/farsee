# SPDX-License-Identifier: Apache-2.0
#
# Result files from `nix build` / `nix develop`.
result
result-*

# Build artifacts. The project uses an out-of-tree build/ directory driven
# by the Makefile (see ADR-0006); keep it out of git.
build/
build-*/
*.o
*.obj
*.a
*.so
*.dylib
*.exe
/bin/
/lib/

# Coverage / sanitizer outputs.
coverage/
*.gcno
*.gcda
*.gcov
*.lcov
asan-logs/
ubsan-logs/
fuzz-corpus/
fuzz-out/
crash-*
leak-*

# Editor / OS noise.
.DS_Store
*.swp
*~
__pycache__/
*.py[cod]
.vscode/
.idea/

# Python bytecode generated by repository tools and their self-tests.
__pycache__/
*.py[cod]

# Root-only: *.plist at the repo root are tool output (test registries);
# sub-tree plist files (e.g. a future Info.plist) stay trackable.
/*.plist

# Private framebuffer output (see captures/README.md).
# Keep the README tracked, ignore everything else in the directory.
captures/*
!captures/README.md
/1
/1.meta
