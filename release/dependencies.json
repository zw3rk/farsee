{
  "schema": 1,
  "release_platforms": [
    "aarch64-darwin",
    "x86_64-darwin"
  ],
  "allowed_licenses": [
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "CC0-1.0",
    "ISC",
    "MIT",
    "Unlicense",
    "Zlib"
  ],
  "dependencies": [
    {
      "name": "FreeRDP",
      "version": "3.15.0",
      "license": "Apache-2.0",
      "store_patterns": ["farsee-freerdp-minimal-3.15.0"],
      "notice": "### FreeRDP 3.15.0"
    },
    {
      "name": "OpenSSL",
      "version": "3.4.3",
      "license": "Apache-2.0",
      "store_patterns": ["openssl-3.4.3"],
      "notice": "### OpenSSL 3.4.3"
    },
    {
      "name": "cJSON",
      "version": "1.7.18",
      "license": "MIT",
      "store_patterns": ["cjson-1.7.18"],
      "notice": "### cJSON 1.7.18"
    },
    {
      "name": "uriparser",
      "version": "0.9.8",
      "license": "BSD-3-Clause",
      "store_patterns": ["uriparser-0.9.8"],
      "notice": "### uriparser 0.9.8"
    },
    {
      "name": "zlib",
      "version": "1.3.1",
      "license": "Zlib",
      "store_patterns": ["zlib-1.3.1"],
      "notice": "### zlib 1.3.1"
    }
  ],
  "forbidden_runtime_patterns": [
    "ffmpeg",
    "libavcodec",
    "libavdevice",
    "libavfilter",
    "libavformat",
    "libavutil",
    "libpostproc",
    "libswresample",
    "libswscale",
    "libusb",
    "libpulseaudio",
    "cups"
  ],
  "system_libraries": [
    {
      "name": "Apple platform runtime",
      "license": "Apple system library",
      "paths": [
        "/System/Library/Frameworks/Carbon.framework/Versions/A/Carbon",
        "/System/Library/Frameworks/CoreFoundation.framework/Versions/A/CoreFoundation",
        "/System/Library/Frameworks/Foundation.framework/Versions/C/Foundation",
        "/usr/lib/libSystem.B.dylib",
        "/usr/lib/libobjc.A.dylib"
      ],
      "notice": "### Apple platform runtime"
    }
  ]
}
